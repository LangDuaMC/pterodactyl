    "scripts": {
        "clean": "rm -rf public/build",
        "test": "bun test",
        "tsc": "tsc --noEmit",
        "lint": "oxlint --react-plugin --tsconfig tsconfig.json resources/scripts/",
        "format": "oxfmt --write resources/scripts/",
        "format:check": "oxfmt --write resources/scripts/ 2>/dev/null 1>/dev/null",
        "dev": "vite",
        "watch": "vite build --watch",
        "build": "vite build",
        "postbuild": "gzip -kfr public/build",
        "build:production": "bun run clean && vite build && gzip -kfr public/build",
        "serve": "bun run dev"
    },
    "browserslist": [
        "fully supports wasm",
        "fully supports webgl",
        "fully supports flexbox",
        "fully supports canvas",
        "fully supports css-cascade-layers",
        "> 5%"
    ],
    "babelMacros": {
        "twin": {
            "preset": "styled-components"
        },
        "styledComponents": {
            "pure": true,
            "displayName": true,
            "fileName": true
        }
    }
